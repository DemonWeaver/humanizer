{
  "name": "humanizer",
  "productName": "Humanizer",
  "version": "1.0.1",
  "description": "Rewrite AI-sounding text to sound human — Windows tray app",
  "author": "DemonWeaver",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "make-icons": "node scripts/make-icons.js",
    "dist": "npm run make-icons && electron-builder --win --x64",
    "dist:portable": "npm run make-icons && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.brandon.humanizer",
    "productName": "Humanizer",
    "directories": { "output": "dist" },
    "publish": [
      { "provider": "github", "owner": "DemonWeaver", "repo": "humanizer", "releaseType": "release" }
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "lib/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Humanizer",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  }
}
